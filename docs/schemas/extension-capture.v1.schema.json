{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://razbiram.com/schemas/extension-capture.v1.schema.json",
  "title": "razbiram screen-to-learn extension capture v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "captureId",
    "createdAt",
    "extension",
    "page",
    "captureMode",
    "captureState",
    "questionFingerprint",
    "stateFingerprint",
    "artifacts",
    "privacy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "extension-capture.v1"
    },
    "captureId": {
      "type": "string",
      "pattern": "^cap_[A-Za-z0-9_-]+$",
      "description": "SHA-256-derived capture identity. See IDENTITY_ALGORITHMS.md."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "extension": {
      "type": "object",
      "required": [
        "browser",
        "extensionVersion",
        "protocolVersion"
      ],
      "properties": {
        "browser": {
          "enum": [
            "chrome",
            "firefox"
          ]
        },
        "extensionVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "protocolVersion": {
          "const": "1.0"
        }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": [
        "origin",
        "path",
        "title",
        "viewport"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "path": {
          "type": "string",
          "maxLength": 2048
        },
        "title": {
          "type": "string",
          "maxLength": 512
        },
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "viewport": {
          "type": "object",
          "required": [
            "width",
            "height",
            "devicePixelRatio"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "devicePixelRatio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "captureMode": {
      "enum": [
        "once",
        "observe",
        "region"
      ]
    },
    "captureState": {
      "enum": ["question", "reveal", "unknown"],
      "description": "Which role this capture plays in the question/reveal pair. The Join stage uses this to select the question-state options and the reveal-state answer key. 'unknown' is valid when the extension cannot determine the role (e.g. single manual capture with no visible feedback); the Join stage routes 'unknown' captures to NeedsReview."
    },
    "questionFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 join key, identical across question and reveal states for the same question. Computed from NFC question text, sorted feedback-stripped option clean texts, card family, and origin scope. See IDENTITY_ALGORITHMS.md."
    },
    "stateFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 dedup key for this specific DOM state. Distinct between question and reveal states; identical across React rerenders of the same semantic state. See IDENTITY_ALGORITHMS.md."
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "description": "Every capture must include a semantic-snapshot artifact (semantic-snapshot.v1, application/json). The semantic-snapshot embeds captureState, questionFingerprint, and stateFingerprint for pipeline stage consumption. When captureMode is 'region', the semantic-snapshot artifact contains a capturedRegion object with the CSS-pixel rectangle and devicePixelRatio."
    },
    "privacy": {
      "type": "object",
      "required": [
        "queryStripped",
        "fragmentStripped",
        "sensitiveFieldsExcluded",
        "scriptsExcluded"
      ],
      "properties": {
        "queryStripped": {
          "type": "boolean"
        },
        "fragmentStripped": {
          "type": "boolean"
        },
        "sensitiveFieldsExcluded": {
          "type": "boolean"
        },
        "scriptsExcluded": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "artifactId",
        "role",
        "mediaType",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^art_[A-Za-z0-9_-]+$"
        },
        "role": {
          "enum": [
            "semantic-snapshot",
            "viewport",
            "region"
          ]
        },
        "mediaType": {
          "enum": [
            "application/json",
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(semantic|artifacts)/[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
