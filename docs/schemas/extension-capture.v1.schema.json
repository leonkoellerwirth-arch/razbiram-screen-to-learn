{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://razbiram.com/schemas/extension-capture.v1.schema.json",
  "title": "razbiram screen-to-learn extension capture v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "captureId",
    "createdAt",
    "extension",
    "page",
    "captureMode",
    "artifacts",
    "privacy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "extension-capture.v1"
    },
    "captureId": {
      "type": "string",
      "pattern": "^cap_[A-Za-z0-9_-]+$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "extension": {
      "type": "object",
      "required": [
        "browser",
        "extensionVersion",
        "protocolVersion"
      ],
      "properties": {
        "browser": {
          "enum": [
            "chrome",
            "firefox"
          ]
        },
        "extensionVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "protocolVersion": {
          "const": "1.0"
        }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": [
        "origin",
        "path",
        "title",
        "viewport"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "path": {
          "type": "string",
          "maxLength": 2048
        },
        "title": {
          "type": "string",
          "maxLength": 512
        },
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "viewport": {
          "type": "object",
          "required": [
            "width",
            "height",
            "devicePixelRatio"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "devicePixelRatio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "captureMode": {
      "enum": [
        "once",
        "observe",
        "region"
      ]
    },
    "questionFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "queryStripped",
        "fragmentStripped",
        "sensitiveFieldsExcluded",
        "scriptsExcluded"
      ],
      "properties": {
        "queryStripped": {
          "type": "boolean"
        },
        "fragmentStripped": {
          "type": "boolean"
        },
        "sensitiveFieldsExcluded": {
          "type": "boolean"
        },
        "scriptsExcluded": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "artifactId",
        "role",
        "mediaType",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^art_[A-Za-z0-9_-]+$"
        },
        "role": {
          "enum": [
            "semantic-snapshot",
            "viewport",
            "region"
          ]
        },
        "mediaType": {
          "enum": [
            "application/json",
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(semantic|artifacts)/[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
